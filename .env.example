# Optional server-only secret, at least 32 characters; explicitly enables the cleanup endpoint.
PROFILE_ASSET_CLEANUP_SECRET
RATE_LIMIT_HMAC_SECRET
WEB_API_RATE_LIMIT_SIGNING_SECRET
# Optional server-only bounded release label; VERCEL_GIT_COMMIT_SHA takes precedence.
AIFANS_RELEASE=local
CREATOR_MODE_ENABLED=true
# Enable only after HUMAN social/chat migrations are applied to the selected environment.
HUMAN_SOCIAL_ENABLED=false
# Server-only, independent random secrets; never expose either in NEXT_PUBLIC variables.
REALTIME_TICKET_SECRET
REALTIME_INTERNAL_SECRET
REALTIME_ISSUER
REALTIME_AUDIENCE
# Comma-separated exact HTTPS origins, without trailing slash or wildcard.
REALTIME_ALLOWED_ORIGINS
# Server HTTPS origin for trusted delivery; browser WSS origin for socket connections.
REALTIME_GATEWAY_URL
NEXT_PUBLIC_REALTIME_URL
