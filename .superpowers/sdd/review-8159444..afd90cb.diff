+      ).rejects.toThrow()
+      await expect(
+        rejectedQuery(owner, () =>
+          owner.query(
+            "UPDATE public.profiles SET created_at = created_at + interval '1 microsecond' WHERE id = $1",
+            [first.id],
+          ),
