{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aifans-realtime-unconfigured",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "env": {
    "test": {
      "name": "aifans-realtime-isolated-test",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {"crons": ["* * * * *"]},
      "ratelimits": [
        {
          "name": "ADMISSION_LIMITER",
          "namespace_id": "2026090401",
          "simple": { "limit": 10, "period": 10 },
        },
      ],
      "vars": {
        "ALLOWED_ORIGINS": "https://ai-parter-v1-web-git-codex-ux-slice-0-1-ruihao-luos-projects.vercel.app",
        "UPSTREAM_API_URL": "https://aifans-api-dev-git-codex-ux-slice-0-1-ruihao-luos-projects.vercel.app"
      },
      "durable_objects": {
        "bindings": [{ "name": "MAILBOXES", "class_name": "RealtimeMailbox" }],
      },
      "migrations": [
        { "tag": "v1-test-sqlite", "new_sqlite_classes": ["RealtimeMailbox"] },
      ],
    },
  },
}
